{
  "devDependencies": {
    "serve": "^14.2.6"
  },
  "scripts": {
    "build": "node -e \"const fs=require('fs');const p=require('path');fs.rmSync('dist',{recursive:true,force:true});fs.mkdirSync('dist',{recursive:true});for(const f of ['index.html','404.html','admin','assets','images','css','js']){if(fs.existsSync(f)){fs.cpSync(f,p.join('dist',f),{recursive:true});}}\"",
    "dev": "serve -s . -l 3000",
    "start": "serve -s . -l 3000"
  }
}
